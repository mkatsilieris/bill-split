# Cloudflare Access settings for the API (read by docker compose, api service).
# Nothing here is secret: the team domain and audience appear in the Access login URL, the ids are
# just addresses. The one secret, CF_API_TOKEN, lives in .env on the server.

# Single sign-on: verify the Access assertion. Empty both values to fall back to e-mail/password only.
ACCESS_TEAM_DOMAIN=odd-sun-cd0f.cloudflareaccess.com
ACCESS_AUD=ece2ca72797b96682cc779ff82614d7585c9e1818a8121ff98269f05fb3d18d3

# Allowlist management from the app: account, Access application and its "Family" policy.
ACCESS_ACCOUNT_ID=bbc0910c94d3beefe9e168b4c8279fd7
ACCESS_APP_ID=2e1a1742-922b-4911-b0db-9d27aa5977de
ACCESS_POLICY_ID=7b6b1cc0-f808-4191-9d6a-5d2c31fe41f8

# App administrators (comma separated). They see "Πρόσβαση από το Internet" in their profile.
ADMIN_EMAILS=ninblack.nib@gmail.com
