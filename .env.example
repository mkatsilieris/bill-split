# Copy to .env and adjust. docker compose reads this file automatically.

# Port exposed on the host (browser + mobile use this)
WEB_PORT=8080

# Public URL of the app (used in password reset emails and as the allowed CORS origin)
APP_URL=http://localhost:8080

# Internet access through Cloudflare Tunnel (see README). Remove both lines to run on the
# local network only. Token: Zero Trust > Networks > Tunnels > bill-split > Configure.
#COMPOSE_PROFILES=internet
#TUNNEL_TOKEN=

# Secret used to sign login tokens. CHANGE THIS on the Raspberry Pi:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# API log detail: debug | info | warn | error. Logs:  docker compose logs -f api
LOG_LEVEL=info

# Database (internal to docker, no need to change)
POSTGRES_USER=billsplit
POSTGRES_PASSWORD=billsplit
POSTGRES_DB=billsplit

# Cloudflare API token used by the admin page to edit the Access allowlist (see README).
# Scopes: Access: Apps and Policies: Edit (+ Access: Organizations, Identity Providers, and Groups: Edit
# so that a removed person is signed out immediately).
#CF_API_TOKEN=

# Push notifications: nothing to set, the API creates its VAPID keys on first start and keeps
# them in the database. Set these only to use your own keys or a different contact.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:you@example.com

# Optional SMTP for "forgot password" and invitation emails.
# If left empty the reset link is printed in the api logs:  docker compose logs api
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bill Split <no-reply@example.com>"
